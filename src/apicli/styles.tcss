Screen {
    layout: horizontal;
}

#workspace {
    height: 1fr;
}

#editor {
    width: 50%;
    height: 1fr;
    border: round $primary;
    margin: 0 0 0 1;
    padding: 0 1;
}

#response {
    width: 50%;
    height: 1fr;
    border: round $accent;
    margin: 0 1;
    padding: 0 1;
}

#urlbar {
    height: auto;
    padding: 0 0 1 0;
}

#urlbar #method {
    width: 14;
}

#urlbar #url-input {
    width: 1fr;
}

#urlbar #auth-badge {
    width: auto;
    margin: 0 1;
    color: $text-muted;
}

#req-area {
    height: 1fr;
    layers: tabs actions;
}

#req-tabs {
    layer: tabs;
    width: 1fr;
    height: 1fr;
}

#req-buttons {
    layer: actions;
    height: 2;
    width: auto;
    dock: right;
    margin-left: 1;
}

#req-buttons Button {
    width: auto;
    height: 1;
    min-height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 1 0 0;
    text-style: none;
    color: $text;
}

#req-buttons #send-button {
    color: $accent;
}

.code-area {
    height: 1fr;
}

.resp-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

.resp-content {
    width: 1fr;
    overflow-x: auto;
    overflow-y: auto;
}

ContentSwitcher {
    height: 1fr;
}

#tab-headers, #tab-body, #tab-auth {
    height: 1fr;
}

#headers-panel, #body-panel {
    height: 1fr;
}

#auth-panel {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#response-tabs {
    height: 1fr;
}

#tab-resp-body {
    height: 1fr;
}

#response-body {
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0 1;
}

#response-status {
    height: auto;
    margin: 1 0;
}

#body-controls {
    height: auto;
    margin: 0 0 1 0;
}

#body-controls #body-type {
    width: 22;
}

.auth-fields {
    margin: 0 0 1 0;
}

#basic-fields, #oauth2-fields, #oauth-actions {
    height: auto;
}

#oauth2-fields Input, #basic-fields Input {
    margin-bottom: 1;
}

#oauth-status.-ok { color: green; }
#oauth-status.-error { color: red; }
#oauth-status.-muted { color: $text-muted; }

ModalScreen {
    align: center middle;
}

#modal {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    align: center middle;
}

.collections-modal {
    width: 45%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 1;
    align: center middle;
}

.collections-modal #collections {
    width: 1fr;
    height: 1fr;
    background: $surface;
}

.collections-modal #popup-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#modal Horizontal {
    height: auto;
    margin-top: 1;
}

#modal Button {
    min-width: 10;
}